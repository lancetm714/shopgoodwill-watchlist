# Telegram push notifications
# Create a bot with @BotFather (send /newbot) to get the token.
# Get your chat id by messaging the bot, then visiting
#   https://api.telegram.org/bot<TOKEN>/getUpdates  (look for "chat":{"id":...})
TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=123456:REPLACE_WITH_YOUR_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID
# How often the backend checks for ending-soon items (seconds)
TELEGRAM_POLL_SECONDS=30
# How often the countdown in the Telegram message is refreshed (seconds)
# (slower default; speeds up automatically in the final minutes)
TELEGRAM_EDIT_SECONDS=30
